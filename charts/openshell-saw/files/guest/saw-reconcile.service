[Unit]
Description=Reconcile SAW inputs changed over virtiofs
After=saw-apply.service
ConditionPathExists=/var/lib/saw/ready

[Service]
Type=oneshot
# Verify-then-stage before reconcile ever runs apply_bom.py: before this,
# reconcile executed apply_bom.py straight off the live virtiofs mount with
# no verification at all, the most direct way to bypass signing.mode
# enforce with vm.liveInputs on (PR #54 review, 2).
ExecStartPre=/usr/local/sbin/saw-stage-installer
ExecStart=/usr/local/sbin/saw-with-lock /usr/local/sbin/saw-reconcile
TimeoutStartSec=45min
StandardOutput=journal+console
StandardError=journal+console
