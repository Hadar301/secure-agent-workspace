[Unit]
Description=SAW installer step 1: install BOM components and start the gateway
Wants=network-online.target
# After multi-user.target, like the golden image's openshell-gateway-setup
# (which is After=multi-user.target): without it, WantedBy=multi-user.target
# would make the target wait for this unit, an ordering cycle that makes
# systemd delete the job at boot. It also keeps image pulls off the boot path.
After=network-online.target multi-user.target openshell-gateway-setup.service
# On first boot cloud-init starts this after the golden image's first-boot
# setup has finished; on later boots it runs on its own.
ConditionPathExists=/var/lib/openshell-gateway-setup.done
StartLimitIntervalSec=1h
StartLimitBurst=6

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/local/sbin/saw-mount-inputs
ExecStart=/usr/bin/python3 /run/saw/installer/apply_bom.py install
Restart=on-failure
RestartSec=60
TimeoutStartSec=30min
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
