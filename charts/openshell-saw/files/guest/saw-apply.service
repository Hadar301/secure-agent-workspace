[Unit]
Description=SAW installer step 2: apply SAW-BOM profiles
Wants=saw-install.service
# After multi-user.target for the same reason as saw-install.service.
After=multi-user.target saw-install.service
ConditionPathExists=/var/lib/openshell-gateway-setup.done
StartLimitIntervalSec=1h
StartLimitBurst=10

[Service]
Type=oneshot
RemainAfterExit=yes
# Same verify-then-stage as saw-install.service: apply_bom.py runs from the
# staged copy, never the live mount (PR #54 review, 2 -- apply used to skip
# verification entirely).
ExecStartPre=/usr/local/sbin/saw-mount-inputs
ExecStartPre=/usr/local/sbin/saw-stage-installer
ExecStart=/usr/local/sbin/saw-with-lock /usr/bin/python3 /var/lib/saw/verified/installer/apply_bom.py apply --installer-dir /var/lib/saw/verified/installer
Restart=on-failure
RestartSec=120
TimeoutStartSec=45min
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
