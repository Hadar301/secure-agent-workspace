{{- if .Values.enabled }}
apiVersion: v1
kind: ConfigMap
metadata:
  name: governance-interceptor-policy
  labels:
    app.kubernetes.io/name: governance-interceptor
    app.kubernetes.io/instance: {{ .Release.Name }}
data:
  policy.yaml: |
{{ .Files.Get "policy.yaml" | indent 4 }}
  github-profile.yaml: |
{{ .Files.Get "profiles/github.yaml" | indent 4 }}
  inference-profile.yaml: |
{{ .Files.Get "profiles/inference.yaml" | indent 4 }}
  google-vertex-ai-profile.yaml: |
{{ .Files.Get "profiles/google-vertex-ai.yaml" | indent 4 }}
  slack-profile.yaml: |
{{ .Files.Get "profiles/slack.yaml" | indent 4 }}
{{- end }}
