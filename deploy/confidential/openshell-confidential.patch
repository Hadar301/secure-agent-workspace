+    /// Check that confidential placement is complete and approved per slot.
+    pub fn validate_confidential_configuration(&self) -> Result<(), String> {
+        if !self.confidential_mode {
+            if !self.confidential_supervisors.is_empty() || !self.confidential_workloads.is_empty()
+            {
+                return Err("confidential placement entries require confidential_mode".to_string());
+            }
+            return Ok(());
+        }
+        if !is_dns1123_subdomain(&self.default_runtime_class_name)
+            || self.supervisor_runtime_class_name != self.default_runtime_class_name
+            || self.supervisor_topology.is_some()
+            || self.confidential_supervisors.is_empty()
+            || self
+                .confidential_supervisors
+                .keys()
+                .collect::<BTreeSet<_>>()
+                != self.confidential_workloads.keys().collect::<BTreeSet<_>>()
+        {
+            return Err("confidential placement configuration is incomplete".to_string());
+        }
+        for (slot, supervisor) in &self.confidential_supervisors {
+            let Some((workspace, sandbox)) = slot.split_once('/') else {
+                return Err("confidential slot identity is invalid".to_string());
+            };
+            if slot.matches('/').count() != 1
+                || !is_dns_1123_label(workspace)
+                || !is_dns_1123_label(sandbox)
+                || supervisor.runtime_class_name != self.default_runtime_class_name
+                || !is_dns1123_subdomain(&supervisor.runtime_class_name)
+                || !valid_confidential_bootstrap(&supervisor.bootstrap_json)
+                || !valid_init_data(&supervisor.init_data)
+            {
+                return Err("confidential supervisor placement is invalid".to_string());
+            }
+            let workload = &self.confidential_workloads[slot];
+            if workload.runtime_class_name != self.default_runtime_class_name
+                || !is_dns1123_subdomain(&workload.runtime_class_name)
+                || !valid_init_data(&workload.init_data)
+            {
+                return Err("confidential workload placement is invalid".to_string());
+            }
+        }
+        Ok(())
+    }
