+#[cfg(test)]
+mod confidential_tests {
+    use super::*;
+    #[test]
+    fn applies_placement_and_guest_local_proxy() {
+        let pod = Pod {
+            spec: Some(PodSpec {
+                containers: vec![Container {
+                    name: "supervisor".into(),
+                    command: Some(vec![
+                        "/openshell-supervisor".into(),
+                        "--upstream-proxy".into(),
+                        "https://external.example".into(),
+                    ]),
+                    ..Default::default()
+                }],
+                ..Default::default()
+            }),
+            ..Default::default()
+        };
+        let cfg = crate::config::ConfidentialSupervisorPlacement {
+            runtime_class_name: "kata-remote".into(),
+            init_data: "bWVhc3VyZWQtZml4dHVyZQ==".into(),
+            bootstrap_json: crate::config::CONFIDENTIAL_BOOTSTRAP_FIXTURE.into(),
+        };
+        let result = confidential_supervisor_pod(pod, true, "kata-remote", Some(&cfg)).unwrap();
+        let spec = result.spec.unwrap();
+        assert_eq!(spec.runtime_class_name.as_deref(), Some("kata-remote"));
+        assert!(spec.volumes.as_ref().is_none_or(|volumes| {
+            !volumes
+                .iter()
+                .any(|volume| volume.name == "saw-confidential")
+        }));
+        let environment = spec.containers[0].env.as_ref().unwrap();
+        assert_eq!(
+            environment
+                .iter()
+                .filter(|env| env.name == "SAW_CONFIDENTIAL_BOOTSTRAP_JSON")
+                .count(),
+            1
+        );
+        assert!(
+            environment
+                .iter()
+                .any(|env| env.name == "SAW_CONFIDENTIAL_BOOTSTRAP_JSON"
+                    && env.value.as_deref() == Some(cfg.bootstrap_json.as_str()))
+        );
+        let command = spec.containers[0].command.as_ref().unwrap();
+        assert_eq!(command[0], "/usr/local/bin/saw-credential-proxy");
+        assert!(!command.iter().any(|arg| arg.contains("external.example")));
+        assert!(command.iter().any(|arg| arg == "http://127.0.0.1:3128"));
+        assert_eq!(
+            result.metadata.annotations.unwrap()["io.katacontainers.config.hypervisor.cc_init_data"],
+            "bWVhc3VyZWQtZml4dHVyZQ=="
+        );
+    }
+    #[test]
+    fn leaves_plain_supervisor_unchanged() {
+        assert_eq!(
+            confidential_supervisor_pod(Pod::default(), false, "", None).unwrap(),
+            Pod::default()
+        );
+    }
+
+    #[test]
+    fn confidential_supervisor_rejects_missing_placement() {
+        assert!(
+            confidential_supervisor_pod(Pod::default(), true, "kata-remote", None)
+                .unwrap_err()
+                .contains("placement is missing")
+        );
+    }
+
+    #[test]
+    fn confidential_workload_sets_class_and_measured_init_data() {
+        let resource = serde_json::json!({"spec":{"podTemplate":{"metadata":{},"spec":{}}}});
+        let placement = crate::config::ConfidentialWorkloadPlacement {
+            runtime_class_name: "kata-remote".into(),
+            init_data: "bWVhc3VyZWQtZml4dHVyZQ==".into(),
+        };
+        let result =
+            confidential_workload_spec(resource, true, "kata-remote", Some(&placement)).unwrap();
+        assert_eq!(
+            result
+                .pointer("/spec/podTemplate/spec/runtimeClassName")
+                .unwrap(),
+            "kata-remote"
+        );
+        assert_eq!(
+            result.pointer("/spec/podTemplate/metadata/annotations/io.katacontainers.config.hypervisor.cc_init_data").unwrap(),
+            "bWVhc3VyZWQtZml4dHVyZQ=="
+        );
+    }
+
+    #[test]
+    fn confidential_workload_rejects_missing_or_mismatched_placement() {
+        let resource = serde_json::json!({"spec":{"podTemplate":{"metadata":{},"spec":{}}}});
+        assert!(
+            confidential_workload_spec(resource.clone(), true, "kata-remote", None)
+                .unwrap_err()
+                .contains("placement is missing")
+        );
+        let placement = crate::config::ConfidentialWorkloadPlacement {
+            runtime_class_name: "kata-remote".into(),
+            init_data: "bWVhc3VyZWQtZml4dHVyZQ==".into(),
+        };
+        assert!(
+            confidential_workload_spec(resource, true, "kata-ordinary", Some(&placement))
+                .unwrap_err()
+                .contains("invalid")
+        );
