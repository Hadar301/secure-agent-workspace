+/// Add confidential placement after normal OpenShell bootstrap generation.
+/// The guest image must provide SAW's memory-only credential proxy wrapper.
+pub fn confidential_supervisor_pod(
+    mut pod: Pod,
+    required: bool,
+    expected_runtime_class: &str,
+    placement: Option<&crate::config::ConfidentialSupervisorPlacement>,
+) -> Result<Pod, String> {
+    let Some(cfg) = placement.filter(|_| required) else {
+        if required {
+            return Err("confidential supervisor placement is missing".to_string());
+        }
+        if placement.is_some() {
+            return Err("confidential supervisor placement is not enabled".to_string());
+        }
+        return Ok(pod);
+    };
+    let label = |s: &str| {
+        !s.is_empty()
+            && s.len() <= 63
+            && s.bytes()
+                .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-')
+    };
+    if !label(&cfg.runtime_class_name)
+        || !crate::config::valid_confidential_bootstrap(&cfg.bootstrap_json)
+        || cfg.runtime_class_name != expected_runtime_class
+        || cfg.init_data.is_empty()
+        || cfg.init_data.len() > 200_000
+    {
+        return Err("confidential supervisor configuration rejected".to_string());
+    }
+    let spec = pod
+        .spec
+        .as_mut()
+        .ok_or("supervisor specification missing")?;
+    let container = spec
+        .containers
+        .first_mut()
+        .ok_or("supervisor container missing")?;
+    let old = container
+        .command
+        .take()
+        .ok_or("supervisor command missing")?;
+    if old
+        .iter()
+        .any(|s| s == "--upstream-proxy-auth-file" || s == "--upstream-no-proxy")
+    {
+        return Err(
+            "confidential supervisor cannot use external proxy credentials or bypass".to_string(),
+        );
+    }
+    let mut command = vec![
+        "/usr/local/bin/saw-credential-proxy".to_string(),
+        "supervise".to_string(),
+    ];
+    let mut args = old.into_iter();
+    while let Some(arg) = args.next() {
+        if arg == "--upstream-proxy" || arg == "--upstream-proxy-ca-bundle" {
+            args.next();
+        } else if arg != "--upstream-proxy-connect-by-hostname" {
+            command.push(arg);
+        }
+    }
+    command.extend([
+        "--upstream-proxy".to_string(),
+        "http://127.0.0.1:3128".to_string(),
+        "--upstream-proxy-connect-by-hostname".to_string(),
+        "--upstream-proxy-ca-bundle".to_string(),
+        "/run/openshell/saw-proxy-ca.pem".to_string(),
+    ]);
+    container.command = Some(command);
+    let environment = container.env.get_or_insert_default();
+    if environment.iter().any(|env| {
+        env.name == "SAW_CONFIDENTIAL_BOOTSTRAP_JSON" || env.name == "SAW_CONFIDENTIAL_CONFIG"
+    }) {
+        return Err("confidential bootstrap environment is duplicated".to_string());
+    }
+    environment.push(env_var(
+        "SAW_CONFIDENTIAL_BOOTSTRAP_JSON",
+        &cfg.bootstrap_json,
+    ));
+    spec.runtime_class_name = Some(cfg.runtime_class_name.clone());
+    pod.metadata.annotations.get_or_insert_default().insert(
+        "io.katacontainers.config.hypervisor.cc_init_data".to_string(),
+        cfg.init_data.clone(),
+    );
+    Ok(pod)
+}
