+/// Apply the administrator-approved RuntimeClass and measured init-data to an
+/// Agent Sandbox workload template. Missing confidential placement fails
+/// before the driver creates or starts a Kubernetes resource.
+pub fn confidential_workload_spec(
+    mut resource: serde_json::Value,
+    required: bool,
+    expected_runtime_class: &str,
+    placement: Option<&crate::config::ConfidentialWorkloadPlacement>,
+) -> Result<serde_json::Value, String> {
+    let Some(cfg) = placement.filter(|_| required) else {
+        if required {
+            return Err("confidential workload placement is missing".to_string());
+        }
+        if placement.is_some() {
+            return Err("confidential workload placement is not enabled".to_string());
+        }
+        return Ok(resource);
+    };
+    if cfg.runtime_class_name != expected_runtime_class
+        || cfg.runtime_class_name.is_empty()
+        || cfg.init_data.is_empty()
+        || cfg.init_data.len() > 200_000
+        || !cfg
+            .init_data
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'+' | b'/' | b'='))
+    {
+        return Err("confidential workload placement is invalid".to_string());
+    }
+    let spec = resource
+        .pointer_mut("/spec/podTemplate/spec")
+        .and_then(serde_json::Value::as_object_mut)
+        .ok_or("confidential workload Pod specification missing")?;
+    if spec
+        .get("runtimeClassName")
+        .is_some_and(|value| value.as_str() != Some(expected_runtime_class))
+    {
+        return Err("confidential workload RuntimeClass conflicts with approval".to_string());
+    }
+    spec.insert(
+        "runtimeClassName".to_string(),
+        serde_json::Value::String(cfg.runtime_class_name.clone()),
+    );
+    let template = resource
+        .pointer_mut("/spec/podTemplate/metadata")
+        .and_then(serde_json::Value::as_object_mut)
+        .ok_or("confidential workload template metadata missing")?;
+    let annotations = template
+        .entry("annotations")
+        .or_insert_with(|| serde_json::Value::Object(Default::default()))
+        .as_object_mut()
+        .ok_or("confidential workload annotations are invalid")?;
+    let annotation = "io.katacontainers.config.hypervisor.cc_init_data";
+    if annotations
+        .get(annotation)
+        .is_some_and(|value| value.as_str() != Some(cfg.init_data.as_str()))
+    {
+        return Err("confidential workload init-data conflicts with approval".to_string());
+    }
+    annotations.insert(
+        annotation.to_string(),
+        serde_json::Value::String(cfg.init_data.clone()),
+    );
+    Ok(resource)
+}
