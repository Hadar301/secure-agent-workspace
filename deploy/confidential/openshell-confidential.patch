+pub(crate) fn valid_confidential_bootstrap(raw: &str) -> bool {
+    if raw.is_empty() || raw.len() > 64 * 1024 {
+        return false;
+    }
+    let Ok(value) = serde_json::from_str::<serde_json::Value>(raw) else {
+        return false;
+    };
+    let Some(object) = value.as_object() else {
+        return false;
+    };
+    object.len() == 4
+        && object
+            .get("schemaVersion")
+            .and_then(serde_json::Value::as_u64)
+            == Some(1)
+        && object
+            .get("policy")
+            .is_some_and(serde_json::Value::is_object)
+        && object
+            .get("publicCAFile")
+            .and_then(serde_json::Value::as_str)
+            == Some("/run/openshell/saw-proxy-ca.pem")
+        && object
+            .get("resources")
+            .and_then(serde_json::Value::as_object)
+            .is_some_and(|resources| {
+                !resources.is_empty() && resources.values().all(serde_json::Value::is_string)
+            })
+        && serde_json::to_string(&value).ok().as_deref() == Some(raw)
+}
+
+#[cfg(test)]
+pub(crate) const CONFIDENTIAL_BOOTSTRAP_FIXTURE: &str = r#"{"policy":{"allowHosts":["api.example.test"],"bindings":[{"key":"api_key","providers":["nvidia"],"secret":"inference"}],"markerPrefix":"saw","profiles":{"nvidia":["api.example.test"]}},"publicCAFile":"/run/openshell/saw-proxy-ca.pem","resources":{"inference":"default/saw-alice-0123456789abcdef/inference"},"schemaVersion":1}"#;
+
+fn valid_init_data(value: &str) -> bool {
+    if value.is_empty() || value.len() > 200_000 {
+        return false;
+    }
+    BASE64_STANDARD
+        .decode(value)
+        .ok()
+        .is_some_and(|decoded| !decoded.is_empty() && BASE64_STANDARD.encode(decoded) == value)
+}
