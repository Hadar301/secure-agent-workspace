# Lab-only wrapper. Build with the SAW repository as context.
FROM golang@sha256:3965b9511a9bed199f0b4eb146f99c31971a5c0adb3240d9f25e233cbd9e01c8 AS build
RUN git init /src && git -C /src remote add origin https://github.com/openshift/cloud-api-adaptor.git && git -C /src fetch --depth=1 origin 1aec1b36f2fa5120376c78d4f53bb299152aa029 && git -C /src checkout --detach FETCH_HEAD && test "$(git -C /src rev-parse HEAD)" = 1aec1b36f2fa5120376c78d4f53bb299152aa029
WORKDIR /src/src/csi-wrapper
RUN go mod download
COPY deploy/confidential/lab-storage/csi-wrapper-isolation.patch /isolation.patch
RUN printf '%s  %s\n' '19dc5bc07961b49b3988b9f03d503ce9f483ffff853a970ddf40710764ecc2b8' /isolation.patch > /isolation.sha256 && sha256sum -c /isolation.sha256 && cd /src && git apply --check /isolation.patch && git apply /isolation.patch
COPY deploy/confidential/lab-storage/lab_isolation_test.go /src/src/csi-wrapper/pkg/wrapper/lab_isolation_test.go
COPY deploy/confidential/lab-storage/marker /src/src/csi-wrapper/cmd/saw-lab-marker
WORKDIR /src/src/csi-wrapper
RUN CGO_ENABLED=0 go test -mod=readonly -timeout=120s ./pkg/wrapper ./pkg/utils ./cmd/saw-lab-marker
ARG TARGETARCH=amd64
RUN mkdir /out && CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -mod=readonly -trimpath -ldflags='-s -w' -o /out/csi-controller-wrapper ./cmd/csi-controller-wrapper && CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -mod=readonly -trimpath -ldflags='-s -w' -o /out/csi-node-wrapper ./cmd/csi-node-wrapper && CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -mod=readonly -trimpath -ldflags='-s -w' -o /out/csi-podvm-wrapper ./cmd/csi-podvm-wrapper && CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -mod=readonly -trimpath -ldflags='-s -w' -o /out/saw-lab-marker ./cmd/saw-lab-marker
FROM scratch
LABEL org.opencontainers.image.source="https://github.com/openshift/cloud-api-adaptor" org.opencontainers.image.revision="1aec1b36f2fa5120376c78d4f53bb299152aa029" saw.redhat.com/lab-storage="scoped-markers-v1" saw.redhat.com/owned-helper-marker="v1" saw.redhat.com/helper-marker-sha256="bd53830caf7f1c6e358c904d39cd24e9d9cac5d313b85e9b9c16c8d1119f1329" saw.redhat.com/source-patch-sha256="19dc5bc07961b49b3988b9f03d503ce9f483ffff853a970ddf40710764ecc2b8"
COPY --from=build /out/ /
USER 65532:65532
ENTRYPOINT ["/csi-node-wrapper"]
