+// guestStageReason exposes a finite code, never a backend message or input.
+func guestStageReason(err error) string {
+	if errors.Is(err, context.DeadlineExceeded) || status.Code(err) == codes.DeadlineExceeded {
+		return "GuestStageTimeout"
+	}
+	switch status.Code(err) {
+	case codes.Unavailable:
+		return "GuestBackendUnavailable"
+	case codes.InvalidArgument:
+		return "GuestStageRequestRejected"
+	case codes.PermissionDenied:
+		return "GuestStagePermissionDenied"
+	}
+	message := strings.ToLower(err.Error())
+	if strings.Contains(message, "failed to find disk") || strings.Contains(message, "finddiskbylun") {
+		return "GuestDeviceUnavailable"
+	}
+	if strings.Contains(message, "could not format") || strings.Contains(message, "could not mount") {
+		return "GuestMountFailed"
+	}
+	return "GuestStageFailed"
+}
