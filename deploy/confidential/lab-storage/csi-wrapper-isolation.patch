diff --git a/src/csi-wrapper/pkg/wrapper/lab_scope.go b/src/csi-wrapper/pkg/wrapper/lab_scope.go
new file mode 100644
index 0000000..b24d44e
--- /dev/null
+++ b/src/csi-wrapper/pkg/wrapper/lab_scope.go
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: Apache-2.0
+package wrapper
+
+import (
+	"github.com/container-storage-interface/spec/lib/go/csi"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"regexp"
+	"strings"
+)
+
+func labNoRequestSecrets(secrets map[string]string) error {
+	if len(secrets) != 0 {
+		return status.Error(codes.InvalidArgument, "LabCsiSecretRejected")
+	}
+	return nil
+}
+func labCreateScope(namespace string, req *csi.CreateVolumeRequest) error {
+	registration := strings.TrimPrefix(namespace, "saw-ppvc-")
+	if namespace == registration || !regexp.MustCompile(`^[a-f0-9]{16}$`).MatchString(registration) || req.GetParameters()["csi.storage.k8s.io/pvc/namespace"] != "saw-ppvc-probe-"+registration || req.GetParameters()["peerpod"] != "true" {
+		return status.Error(codes.PermissionDenied, "LabClaimScopeRejected")
+	}
+	return labNoRequestSecrets(req.GetSecrets())
+}
