+func (s *PodVMNodeService) reportStageResult(original *peerpodvolumeV1alpha1.PeerpodVolume, reason string) {
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	volumes := s.PeerpodvolumeClient.ConfidentialcontainersV1alpha1().PeerpodVolumes(s.Namespace)
+	latest, err := volumes.Get(ctx, original.Name, metav1.GetOptions{})
+	if err != nil {
+		glog.Error("LabGuestStageStatusReadFailed")
+		return
+	}
+	if latest.Spec.PodUID != original.Spec.PodUID || latest.Spec.VolumeID != original.Spec.VolumeID ||
+		latest.Spec.TargetPath != original.Spec.TargetPath || latest.Spec.VMID != original.Spec.VMID ||
+		latest.Status.State != peerpodvolumeV1alpha1.ControllerPublishVolumeApplied {
+		glog.Error("LabGuestStageStatusIdentityChanged")
+		return
+	}
+	updated := latest.DeepCopy()
+	updated.Status = peerpodvolumeV1alpha1.PeerpodVolumeStatus{State: peerpodvolumeV1alpha1.NodeStageVolumeApplied}
+	if reason != "" {
+		updated.Status.State = "nodeStageVolumeFailed"
+		updated.Status.Reason = reason
+		if reason == "GuestDeviceUnavailable" {
+			counts := labGuestDeviceCounts("/sys/bus/scsi/devices")
+			updated.Status.DeviceProbeAvailable = counts.DeviceProbeAvailable
+			updated.Status.ScsiDeviceCount = counts.ScsiDeviceCount
+			updated.Status.LowScsiHostCount = counts.LowScsiHostCount
+			updated.Status.AzureDiskCount = counts.AzureDiskCount
+		}
+	}
+	if _, err := volumes.UpdateStatus(ctx, updated, metav1.UpdateOptions{}); err != nil {
+		glog.Error("LabGuestStageStatusUpdateFailed")
+	}
+}
 
+func (s *PodVMNodeService) ReproduceNodeStageVolume(peerPodVolume *peerpodvolumeV1alpha1.PeerpodVolume) {
+	// Never issue concurrent stage requests for the same volume.
+	if _, active := s.staging.LoadOrStore(peerPodVolume.Name, true); active {
+		return
+	}
+	defer s.staging.Delete(peerPodVolume.Name)
+	var request csi.NodeStageVolumeRequest
+	var published csi.ControllerPublishVolumeResponse
+	decoder := &jsonpb.Unmarshaler{}
+	if decoder.Unmarshal(bytes.NewReader([]byte(peerPodVolume.Spec.WrapperNodeStageVolumeReq)), &request) != nil ||
+		decoder.Unmarshal(bytes.NewReader([]byte(peerPodVolume.Spec.WrapperControllerPublishVolumeRes)), &published) != nil ||
+		labNoRequestSecrets(request.GetSecrets()) != nil {
+		s.reportStageResult(peerPodVolume, "GuestStageRequestRejected")
+		return
+	}
+	request.PublishContext = published.PublishContext
+	if request.PublishContext == nil {
+		request.PublishContext = map[string]string{}
+	}
+	request.PublishContext["device-path"] = peerPodVolume.Spec.DevicePath
+	timeout := s.operationTimeout
+	if timeout <= 0 {
+		timeout = 90 * time.Second
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), timeout)
+	defer cancel()
+	delay := s.retryDelay
+	if delay <= 0 {
+		delay = 2 * time.Second
+	}
+	reason := ""
+	for attempt := 0; attempt < 30; attempt++ {
+		var backendErr error
+		dialErr := s.redirect(ctx, &request, func(callCtx context.Context, client csi.NodeClient) {
+			_, backendErr = client.NodeStageVolume(callCtx, &request)
+		})
+		if dialErr != nil {
+			backendErr = dialErr
+		}
+		if backendErr == nil {
+			reason = ""
+			break
+		}
+		reason = guestStageReason(backendErr)
+		if reason != "GuestDeviceUnavailable" && reason != "GuestBackendUnavailable" {
+			break
+		}
+		if ctx.Err() != nil || attempt == 29 {
+			break
+		}
+		timer := time.NewTimer(delay)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+		case <-timer.C:
+		}
+		if ctx.Err() != nil {
+			break
+		}
 	}
+	s.reportStageResult(peerPodVolume, reason)
 }
 
