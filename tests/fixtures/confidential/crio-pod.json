{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "qualification-agent",
    "namespace": "saw-alice",
    "labels": {
      "app.kubernetes.io/part-of": "qualification"
    }
  },
  "spec": {
    "runtimeClassName": "kata-remote",
    "restartPolicy": "Never",
    "terminationGracePeriodSeconds": 10,
    "automountServiceAccountToken": false,
    "securityContext": {
      "runAsNonRoot": true,
      "runAsUser": 1001,
      "runAsGroup": 1001,
      "seccompProfile": {
        "type": "RuntimeDefault"
      },
      "fsGroup": 1001
    },
    "containers": [
      {
        "name": "probe",
        "image": "registry.example.test/agent@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "command": [
          "/usr/bin/approved-agent"
        ],
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "readOnlyRootFilesystem": true,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "resources": {
          "requests": {
            "cpu": "100m",
            "memory": "128Mi"
          },
          "limits": {
            "cpu": "1",
            "memory": "512Mi"
          }
        }
      }
    ]
  }
}
