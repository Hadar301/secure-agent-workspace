#!/usr/bin/env python3
"""Fake podman for installer tests.

images.json maps image -> {path-in-image: {"type": "binary", "version": v}
or {"type": "nemoclaw"}}. Every call is appended to podman.log.
"""
import json
import os
import sys
from pathlib import Path

state = Path(os.environ["FAKE_STATE"])
args = sys.argv[1:]
with open(state / "podman.log", "a") as log:
    log.write(json.dumps(args) + "\n")

images = json.loads((state / "images.json").read_text()) if (state / "images.json").exists() else {}
containers_file = state / "containers.json"
containers = json.loads(containers_file.read_text()) if containers_file.exists() else {}

cmd = args[0] if args else ""
if cmd == "pull":
    image = args[-1]
    if image not in images:
        print(f"Error: initializing source docker://{image}: manifest unknown", file=sys.stderr)
        sys.exit(125)
    print("sha256:" + "0" * 64)
elif cmd == "create":
    image = args[-1]
    cid = f"c{len(containers) + 1:04d}"
    containers[cid] = image
    containers_file.write_text(json.dumps(containers))
    print(cid)
elif cmd == "cp":
    src, dest = args[1], Path(args[2])
    cid, path = src.split(":", 1)
    content = images.get(containers.get(cid, ""), {}).get(path)
    if content is None:
        print(f"Error: \"{path}\" could not be found on container {cid}", file=sys.stderr)
        sys.exit(125)
    if content["type"] == "binary":
        dest.write_text("#!/bin/sh\n"
                        f"if [ \"$1\" = --version ]; then echo \"{dest.name} {content['version']}\"; exit 0; fi\n"
                        "exit 0\n")
    elif content["type"] == "nemoclaw":
        (dest / "bin").mkdir(parents=True)
        (dest / "bin" / "nemoclaw.js").write_text("console.log('nemoclaw')\n")
elif cmd in ("rm", "ps", "exec"):
    pass
else:
    print(f"fake podman: unsupported {args}", file=sys.stderr)
    sys.exit(2)
