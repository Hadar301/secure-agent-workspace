#!/usr/bin/env python3
"""Fake getsebool: state in sebool.json; missing boolean -> error."""
import json, os, sys
from pathlib import Path
state = Path(os.environ["FAKE_STATE"]) / "sebool.json"
values = json.loads(state.read_text()) if state.exists() else {"virt_qemu_ga_manage_ssh": "off"}
name = sys.argv[1]
if name not in values:
    print(f"Error getting active value for {name}", file=sys.stderr); sys.exit(1)
print(f"{name} --> {values[name]}")
