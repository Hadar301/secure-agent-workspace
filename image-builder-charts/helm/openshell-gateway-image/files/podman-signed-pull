#!/bin/bash
# Pull one image under the enforce signature policy, then restore the
# system policy. Used only when signing.mode is enforce.
set -euo pipefail
image="${1:?image required}"
policy="${SAW_ENFORCE_POLICY:-/etc/saw/policy/enforce.json}"
if [[ ! -f "$policy" ]]; then
  echo "signature policy ${policy} is missing" >&2
  exit 1
fi
if [[ ! -f /etc/containers/policy.json ]]; then
  echo "/etc/containers/policy.json is missing" >&2
  exit 1
fi
backup=$(mktemp)
cp /etc/containers/policy.json "$backup"
restore() { cp "$backup" /etc/containers/policy.json; rm -f "$backup"; }
trap restore EXIT
cp "$policy" /etc/containers/policy.json
podman pull --quiet "$image"
